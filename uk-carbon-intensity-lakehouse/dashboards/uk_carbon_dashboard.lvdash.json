{
  "datasets": [
    {
      "name": "1799d35f",
      "displayName": "heatmap_avg_intensity",
      "queryLines": [
        "SELECT day_of_week,\r\n",
        "       day_name,\r\n",
        "       hour_uk,\r\n",
        "       MEASURE(avg_intensity) AS avg_intensity\r\n",
        "FROM portfolio.uk_carbon_gold.metrics_carbon_intensity\r\n",
        "WHERE :region = 'All regions' OR region = :region\r\n",
        "GROUP BY day_of_week, day_name, hour_uk\r\n",
        "ORDER BY day_of_week, hour_uk"
      ],
      "parameters": [
        {
          "displayName": "region",
          "keyword": "region",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All regions"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "e748ffef",
      "displayName": "region_list",
      "queryLines": [
        "SELECT region, half_hours\r\n",
        "FROM (\r\n",
        "  SELECT 'All regions' AS region, MEASURE(half_hours) AS half_hours, 0 AS sort_key\r\n",
        "  FROM portfolio.uk_carbon_gold.metrics_carbon_intensity\r\n",
        "  UNION ALL\r\n",
        "  SELECT region, MEASURE(half_hours) AS half_hours, 1 AS sort_key\r\n",
        "  FROM portfolio.uk_carbon_gold.metrics_carbon_intensity\r\n",
        "  GROUP BY region\r\n",
        ")\r\n",
        "ORDER BY sort_key, region"
      ]
    },
    {
      "name": "be63a5e0",
      "displayName": "now_intensity",
      "queryLines": [
        "WITH per_half_hour AS (\r\n",
        "  SELECT half_hour_utc,\r\n",
        "         half_hour_uk,\r\n",
        "         MEASURE(avg_intensity) AS avg_intensity,\r\n",
        "         MEASURE(half_hours)    AS regions_counted\r\n",
        "  FROM portfolio.uk_carbon_gold.metrics_carbon_intensity\r\n",
        "  WHERE :region = 'All regions' OR region = :region\r\n",
        "  GROUP BY half_hour_utc, half_hour_uk\r\n",
        ")\r\n",
        "SELECT half_hour_uk,\r\n",
        "       date_format(half_hour_uk, 'yyyy-MM-dd HH:mm') AS half_hour_london,\r\n",
        "       avg_intensity,\r\n",
        "       regions_counted\r\n",
        "FROM per_half_hour\r\n",
        "WHERE half_hour_utc = (SELECT MAX(half_hour_utc) FROM per_half_hour)"
      ],
      "parameters": [
        {
          "displayName": "region",
          "keyword": "region",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All regions"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "30e0284d",
      "displayName": "now_index_classes",
      "queryLines": [
        "WITH per_class AS (\r\n",
        "  SELECT half_hour_utc,\r\n",
        "         intensity_index,\r\n",
        "         MEASURE(half_hours) AS regions\r\n",
        "  FROM portfolio.uk_carbon_gold.metrics_carbon_intensity\r\n",
        "  WHERE :region = 'All regions' OR region = :region\r\n",
        "  GROUP BY half_hour_utc, intensity_index\r\n",
        "),\r\n",
        "latest AS (\r\n",
        "  SELECT intensity_index, regions\r\n",
        "  FROM per_class\r\n",
        "  WHERE half_hour_utc = (SELECT MAX(half_hour_utc) FROM per_class)\r\n",
        "),\r\n",
        "classes AS (\r\n",
        "  SELECT intensity_index, index_order\r\n",
        "  FROM VALUES ('very low', 1), ('low', 2), ('moderate', 3), ('high', 4), ('very high', 5)\r\n",
        "       AS c(intensity_index, index_order)\r\n",
        ")\r\n",
        "SELECT c.intensity_index,\r\n",
        "       COALESCE(l.regions, 0) AS regions,\r\n",
        "       c.index_order\r\n",
        "FROM classes c\r\n",
        "LEFT JOIN latest l\r\n",
        "       ON l.intensity_index = c.intensity_index\r\n",
        "ORDER BY c.index_order"
      ],
      "parameters": [
        {
          "displayName": "region",
          "keyword": "region",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All regions"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "c100f93f",
      "displayName": "mix_best_worst",
      "queryLines": [
        "WITH cells AS (\r\n",
        "  SELECT day_of_week,\r\n",
        "         day_name,\r\n",
        "         hour_uk,\r\n",
        "         MEASURE(avg_intensity) AS avg_intensity\r\n",
        "  FROM portfolio.uk_carbon_gold.metrics_carbon_intensity\r\n",
        "  WHERE :region = 'All regions' OR region = :region\r\n",
        "  GROUP BY day_of_week, day_name, hour_uk\r\n",
        "),\r\n",
        "ranked AS (\r\n",
        "  SELECT day_of_week, day_name, hour_uk, avg_intensity,\r\n",
        "         ROW_NUMBER() OVER (ORDER BY avg_intensity ASC)  AS rank_best,\r\n",
        "         ROW_NUMBER() OVER (ORDER BY avg_intensity DESC) AS rank_worst\r\n",
        "  FROM cells\r\n",
        "),\r\n",
        "extremes AS (\r\n",
        "  SELECT CASE WHEN rank_best = 1 THEN 'Best' ELSE 'Worst' END AS side,\r\n",
        "         day_of_week, day_name, hour_uk, avg_intensity\r\n",
        "  FROM ranked\r\n",
        "  WHERE rank_best = 1 OR rank_worst = 1\r\n",
        "),\r\n",
        "mix AS (\r\n",
        "  SELECT day_of_week,\r\n",
        "         hour_uk,\r\n",
        "         fuel_group,\r\n",
        "         MEASURE(avg_share_pct) AS avg_share_pct\r\n",
        "  FROM portfolio.uk_carbon_gold.metrics_generation_mix\r\n",
        "  WHERE :region = 'All regions' OR region = :region\r\n",
        "  GROUP BY day_of_week, hour_uk, fuel_group\r\n",
        ")\r\n",
        "SELECT concat(e.side, ': ', e.day_name, ' ', CAST(e.hour_uk AS STRING)) AS cell_label,\r\n",
        "       e.side,\r\n",
        "       m.fuel_group,\r\n",
        "       m.avg_share_pct,\r\n",
        "       e.avg_intensity\r\n",
        "FROM extremes e\r\n",
        "JOIN mix m\r\n",
        "  ON  m.day_of_week = e.day_of_week\r\n",
        "  AND m.hour_uk     = e.hour_uk\r\n",
        "ORDER BY e.side, m.fuel_group"
      ],
      "parameters": [
        {
          "displayName": "region",
          "keyword": "region",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All regions"
                }
              ]
            }
          }
        }
      ]
    }
  ],
